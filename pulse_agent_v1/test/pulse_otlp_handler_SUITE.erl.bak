%% @doc Test invalid content type returns 415
invalid_content_type_test(_Config) ->
    Payload = <<"{}">>,
    case httpc:request(post, {"http://localhost:8083/v1/traces", [], "text/plain", Payload}, [], [{sync, true}]) of
        {ok, {{_, 415, _}, _, Body}} ->
            {ok, Decoded} = jiffy:decode(Body, [return_maps]),
            case maps:get(<<"status">>, Decoded) of
                <<"error">> -> {pass, "415 for invalid content type"};
                _ -> {fail, "unexpected status"}
            end;
        {ok, {{_, Status, _}, _, _}} ->
            {fail, "unexpected status: " ++ integer_to_list(Status)};
        {error, Reason} ->
            {fail, "request failed: " ++ Reason}
    end.

%% @doc Test empty payload returns 400
empty_payload_test(_Config) ->
    case httpc:request(post, {"http://localhost:8083/v1/traces", [], "application/json", <<>>}, [], [{sync, true}]) of
        {ok, {{_, 400, _}, _, Body}} ->
            {ok, Decoded} = jiffy:decode(Body, [return_maps]),
            case maps:get(<<"status">>, Decoded) of
                <<"error">> -> {pass, "400 for empty payload"};
                _ -> {fail, "unexpected status"}
            end;
        {ok, {{_, Status, _}, _, _}} ->
            {fail, "expected 400, got: " ++ integer_to_list(Status)};
        {error, Reason} ->
            {fail, "request failed: " ++ Reason}
    end.

%% @doc Test normalization produces valid output
normalization_test(_Config) ->
    %% Simple trace payload - build using maps:from_list to avoid map literal syntax issues with binary keys
    Payload = jiffy:encode(
        maps:from_list([
            {<<"resourceSpans">>, [
                maps:from_list([
                    {<<"resource">>, #{<<"attributes">> => []}},
                    {<<"scopeSpans">>, [
                        maps:from_list([
                            {<<"scope">>, #{}},
                            {<<"spans">>, [
                                maps:from_list([
                                    {<<"traceId">>, <<"0123456789abcdef">>},
                                    {<<"spanId">>, <<"01234567">>},
                                    {<<"name">>, <<"test-span">>},
                                    {<<"kind">>, 2},
                                    {<<"startTimeUnixNano">>, 1234567890000000000},
                                    {<<"endTimeUnixNano">>, 1234567891000000000},
                                    {<<"attributes">>, []},
                                    {<<"events">>, []},
                                    {<<"links">>, []},
                                    {<<"status">>, #{<<"code">> => 1, <<"message">> => <<"OK">>}}
                                ])
                            ])
                        ])
                    }]
                }
            ])
        ])
    }),
    case httpc:request(post, {"http://localhost:8083/v1/traces", [], "application/json", Payload}, [], [{sync, true}]) of
        {ok, {{_, 200, _}, _, Body}} ->
            {ok, Decoded} = jiffy:decode(Body, [return_maps]),
            case maps:get(<<"status">>, Decoded) of
                <<"ok">> ->
                    Count = maps:get(<<"count">>, Decoded, 0),
                    case Count > 0 of
                        true -> {pass, "trace normalized and sent to Kafka, count: " ++ integer_to_list(Count)};
                        false -> {fail, "count should be > 0"}
                    end;
                _ -> {fail, "unexpected status"}
            end;
        {ok, {{_, Status, _}, _, _}} ->
            {fail, "unexpected status: " ++ integer_to_list(Status)};
        {error, Reason} ->
            {fail, "request failed: " ++ Reason}
    end.