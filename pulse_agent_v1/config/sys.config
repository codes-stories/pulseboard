[
    {lager, [
        {handlers, [
            {lager_console_backend, info, [
                {formatter, lager_default_formatter, [
                    "{time} [{severity}] {module}:{line} - {message}\n"
                ]}
            ]}
        ]},
        {crash_log, "/tmp/pulse_agent_v1_crash.log"},
        {crash_log_msg, "{time} [{severity}] {module}:{line} - {message}\n"},
        {crash_log_size, 10485760},
        {crash_log_date, "$D0"},
        {crash_log_count, 5}
    ]},
    {brod, [
        {clients, [
            {pulse_agent_v1_client, [
                {endpoints, [{"localhost", 9092}]},
                {reconnect_cool_down_seconds, 10},
                {auto_start_producers, true},
                {default_producer_config, []}
            ]}
        ]}
    ]},
    {pulse_agent_v1, [
        {http_port, 8082},
        {postgres_enabled, true},
        {postgres_host, "localhost"},
        {postgres_port, 5432},
        {postgres_database, "pulse_agent_v1"},
        {postgres_username, "myuser"},
        {postgres_password, "mypassword"},
        {kafka_enabled, false},
        {kafka_brokers, "localhost:9092"},
        {kafka_client_id, "pulse_agent_v1"},
        {kafka_topic, "api-logs"},
        {kafka_acks, "all"},
        {kafka_batch_size, 16384},
        {kafka_linger_ms, 5},
        {kafka_compression, "none"},
        {backend_api_url, "http://localhost:8080"},
        {backend_sync_enabled, false},
        {backend_sync_interval_ms, 30000},
        {backend_sync_batch_size, 100},
        {backend_api_key, ""}
    ]}
].