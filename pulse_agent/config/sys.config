[
  {kernel, [
    %% OTP's standard handler writes structured log events to stdout.
    %% Override with `-kernel logger_level debug` while diagnosing issues.
    {logger_level, info}
  ]},
  {pulse_agent, [
    {backend_url, "http://127.0.0.1:8080"},
    {connect_path, "/api/agent/connect"},
    {disconnect_path, "/api/agent/disconnect"},
    {request_timeout, 5000},
    %% Reserved application logging settings for agent workers and clients.
    {log_level, info}
  ]}
].
