PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/pulseboard

JWT_SECRET=super-secret

REDIS_ADDR=localhost:6379

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Swagger / OpenAPI UI. Defaults to false; enable only in development.
SWAGGER_ENABLED=false

# Agent enrollment token TTL (Go duration, e.g. 15m, 1h).
AGENT_ENROLLMENT_TOKEN_TTL=15m

# Agent API key lifetime (Go duration, e.g. 720h, 8760h).
AGENT_API_KEY_TTL=8760h

# Agent traffic rate limits (requests per minute). 0 disables the limit.
AGENT_ENROLLMENT_RATE_LIMIT=5
AGENT_AUTH_RATE_LIMIT=120
AGENT_HEARTBEAT_RATE_LIMIT=120
AGENT_RESULT_RATE_LIMIT=600

# Installation command metadata surfaced to the frontend.
PULSE_AGENT_INSTALL_URL=https://install.pulseboard.dev
PULSE_AGENT_DOWNLOAD_BASE_URL=https://downloads.pulseboard.dev
PULSE_AGENT_VERSION=0.1.0

# API tester proxy behavior.
APITEST_PROXY_TIMEOUT=10s
APITEST_MAX_RESPONSE_BYTES=1048576
# Allow proxying to private/localhost targets. Keep false in production (SSRF).
APITEST_ALLOW_PRIVATE=false

# AI payload generation (OpenAI-compatible). Leave OPENAI_API_KEY empty to use
# the built-in deterministic local generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Comma-separated list of browser origins allowed to call the API (e.g. your Vercel domain)
CORS_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
